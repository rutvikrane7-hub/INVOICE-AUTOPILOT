# ── Supabase ───────────────────────────────────────────────────────
# Get these from: https://supabase.com > Project > Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Vercel Serverless Functions / webhooks)
# Get this from: Supabase > Settings > API > service_role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ── Razorpay (Indian payments) ─────────────────────────────────────
# Create payment links in Razorpay dashboard and paste the URLs here.
# In the payment link, add a "note" field called "plan" with value "pro" or "business"
# and a "email" field so the webhook can identify the user.

VITE_RAZORPAY_PRO_LINK=https://rzp.io/l/your-pro-link
VITE_RAZORPAY_BUSINESS_LINK=https://rzp.io/l/your-business-link

# Webhook secret from Razorpay > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret


# ── Lemon Squeezy (International payments) ─────────────────────────
# Create products + checkout links in LS dashboard

VITE_LS_PRO_CHECKOUT=https://your-store.lemonsqueezy.com/checkout/buy/your-pro-variant
VITE_LS_BUSINESS_CHECKOUT=https://your-store.lemonsqueezy.com/checkout/buy/your-business-variant

# From LS dashboard > Settings > Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=your-ls-webhook-secret

# Variant IDs from LS dashboard (for webhook mapping)
LS_PRO_VARIANT_ID=12345
LS_BUSINESS_VARIANT_ID=67890
